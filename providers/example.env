# Example provider configuration
# Copy this file and rename it to your provider name (e.g., my-provider.env)

# For Anthropic/Claude compatible APIs:
export ANTHROPIC_BASE_URL=https://api.example.com/anthropic
export ANTHROPIC_AUTH_TOKEN=your_token_here
export ANTHROPIC_MODEL=claude-3-opus-20240229

# Optional: Set model aliases
export ANTHROPIC_SMALL_FAST_MODEL=claude-3-haiku-20240307
export ANTHROPIC_DEFAULT_SONNET_MODEL=claude-3-sonnet-20240229
export ANTHROPIC_DEFAULT_OPUS_MODEL=claude-3-opus-20240229
export ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-3-haiku-20240307

# For OpenAI compatible APIs:
# export OPENAI_API_KEY=your_key_here
# export OPENAI_BASE_URL=https://api.example.com/v1
# export OPENAI_MODEL=gpt-4o

# Clean up conflicting variables:
unset OPENAI_API_KEY
unset OPENAI_BASE_URL
unset OPENAI_MODEL
