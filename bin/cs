#!/bin/bash

CS_HOME="${HOME}/.cs"
PROVIDERS_DIR="${CS_HOME}/providers"

# Load wizard (interactive provider setup)
# shellcheck source=/dev/null
[[ -f "${CS_HOME}/lib/cs-wizard.sh" ]] && source "${CS_HOME}/lib/cs-wizard.sh"

# Fallback if cs-wizard.sh failed to load (broken/partial install)
if ! declare -f _cs_dispatch >/dev/null 2>&1; then
    _cs_dispatch() { echo "$2"; return 1; }
fi

show_help() {
    echo "cs - Claude Code Provider Switcher"
    echo ""
    echo "Usage:"
    echo "  cs <provider>       Switch to provider"
    echo "  cs -l               List all providers"
    echo "  cs -c               Show current provider"
    echo "  cs -e <provider>    Edit provider config"
    echo "  cs -a               Add new provider (interactive)"
    echo "  cs -d <provider>    Delete provider"
    echo "  cs -r               Reset to official Claude Code (clear active provider)"
    echo "  cs -u               Update cs to latest version"
    echo "  cs -h               Show this help"
}

list_providers() {
    if [[ ! -d "$PROVIDERS_DIR" ]]; then
        echo "❌ Providers directory not found: $PROVIDERS_DIR"
        return 1
    fi

    echo "Available providers:"
    local has_provider=false
    for f in "$PROVIDERS_DIR"/*.env; do
        if [[ -f "$f" ]]; then
            has_provider=true
            local name=$(basename "$f" .env)
            local current=""
            [[ "$name" == "$CS_PROVIDER" ]] && current=" *"
            echo "  $name$current"
        fi
    done

    if [[ "$has_provider" == false ]]; then
        echo "  (none)"
    fi
}

show_current() {
    if [[ -n "$CS_PROVIDER" ]]; then
        echo "Current provider: $CS_PROVIDER"
    else
        echo "No provider set"
    fi
}

edit_provider() {
    local provider="$1"
    if [[ -z "$provider" ]]; then
        echo "❌ Please specify provider name"
        echo "Usage: cs -e <provider>"
        return 1
    fi

    local config_file="${PROVIDERS_DIR}/${provider}.env"

    if [[ ! -f "$config_file" ]]; then
        echo "❌ Provider '$provider' not found. Run 'cs -l' to list."
        return 1
    fi

    "${EDITOR:-vi}" "$config_file"
}

delete_provider() {
    local provider="$1"
    if [[ -z "$provider" ]]; then
        echo "❌ Please specify provider name"
        echo "Usage: cs -d <provider>"
        return 1
    fi

    local config_file="${PROVIDERS_DIR}/${provider}.env"

    if [[ ! -f "$config_file" ]]; then
        echo "❌ Provider '$provider' not found. Run 'cs -l' to list."
        return 1
    fi

    read -p "Are you sure you want to delete '$provider'? [y/N] " confirm
    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        rm "$config_file"
        echo "✅ Deleted provider: $provider"
    else
        echo "Cancelled"
    fi
}

reset_provider() {
    if [[ -z "$CS_PROVIDER" ]]; then
        echo "ℹ️  当前未设置 provider，已经是官方 Claude Code 默认配置"
        return 0
    fi

    local prev="$CS_PROVIDER"
    unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    unset ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
    unset ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
    unset OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL
    unset CS_PROVIDER
    echo "✅ 已从 '$prev' 恢复官方 Claude Code 默认配置"
}

switch_provider() {
    local provider="$1"
    local config_file="${PROVIDERS_DIR}/${provider}.env"

    if [[ ! -f "$config_file" ]]; then
        echo "❌ Provider '$provider' not found. Run 'cs -l' to list."
        return 1
    fi

    # Clear previous environment variables
    unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    unset ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
    unset ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
    unset OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL

    # Load new configuration
    source "$config_file"
    export CS_PROVIDER="$provider"

    # Save to .cs file in current directory if it looks like a project
    if [[ -d ".git" ]] || [[ -f "package.json" ]] || [[ -f "README.md" ]] || [[ -f "Cargo.toml" ]] || [[ -f "go.mod" ]]; then
        echo "$provider" > .cs
        echo "✅ Switched to $provider (saved to .cs)"
    else
        echo "✅ Switched to $provider"
    fi
}

case "$1" in
    -l|--list)
        list_providers
        ;;
    -c|--current)
        show_current
        ;;
    -e|--edit)
        edit_provider "$2"
        ;;
    -a|--add)
        if [[ -n "$2" ]]; then
            echo "ℹ️  cs -a 不接受参数，请在交互向导中选择/设置别名。已忽略: $2"
        fi
        _cs_dispatch _cs_cmd_add "❌ Wizard not available. Please reinstall cs."
        ;;
    -d|--delete)
        delete_provider "$2"
        ;;
    -r|--reset)
        reset_provider
        ;;
    -u|--update)
        _cs_dispatch _cs_cmd_update "❌ Update not available. Please reinstall cs."
        ;;
    -h|--help)
        show_help
        ;;
    "")
        show_help
        ;;
    -*)
        echo "❌ Unknown option: $1"
        show_help
        exit 1
        ;;
    *)
        switch_provider "$1"
        ;;
esac
